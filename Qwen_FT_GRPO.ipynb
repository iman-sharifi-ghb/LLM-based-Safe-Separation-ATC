    "def extract_action(text: str):\n",
    "    \"\"\"\n",
    "    Search (Decelerate/Hold/Accelerate) actions in the text, and output it.\n",
    "    Input: Text, like \"The recommended action for the ownship is \"Accelerate\".\n",
    "    Output: Action, like \"Accelerate\"\n",
    "    \"\"\"\n",
    "\n",
    "    # search for the action in the text \n",
    "    action = re.search(r\"\\b(Accelerate|Hold|Decelerate)\\b\", text, flags=re.IGNORECASE)\n",
    "    final_action = action.group(1).capitalize() if action else None\n",
    "    return final_action\n",
    "    \n",
    "test_text = \"The recommended action for the ownship is Reduce Speed.\"\n",
